NODE_ENV="development"

# Database (Supabase PostgreSQL)
# Use the TRANSACTION pooler (port 6543) for serverless (Netlify/Vercel).
# Session mode (5432) caps ~15 clients and causes 500s under concurrent API calls.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Optional direct connection for migrations / prisma db push:
# DIRECT_URL="postgresql://user:password@db.xxxx.supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="your-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Guest cleanup cron (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`)
CRON_SECRET="a-long-random-string"
# Days of inactivity before a guest account is deleted (default: 7)
GUEST_RETENTION_DAYS="7"
